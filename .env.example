# ===== 1С HTTP-сервис =====
# Логин/пароль для Basic Auth
MCP_USER=mcp
MCP_PASSWORD=change_me_please

# URL HTTP-сервиса 1С
MCP_QUERY_URL=http://erp-700/Vysotskaya_TA/hs/mcp-1c/query

# ===== MCP-серверы (config.yaml) =====
# Токен для codepilot1c — ВАЖНО: ротировать после утечки в git!
MCP_CODEPILOT_TOKEN=replace_with_rotated_token
MCP_1C_USER=mcp
MCP_1C_PASSWORD=change_me_please

# ===== Flask-приложение =====
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# ===== Логирование =====
LOG_LEVEL=INFO
LOG_FILE=app.log

# ===== Файлы и сессии =====
DB_PATH=guid_cache.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=104857600
SESSION_TTL=3600
