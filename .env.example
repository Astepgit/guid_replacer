# Переменные окружения для MCP-сервера 1С
# Скопируйте этот файл в .env и заполните свои данные

# Basic Auth
MCP_USER=your_username
MCP_PASSWORD=your_password

# URL HTTP-сервиса 1С
MCP_QUERY_URL=http://erp-700/Vysotskaya_TA/hs/mcp-1c/query

# Конфигурация приложения
DB_PATH=guid_cache.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=104857600
SESSION_TTL=3600

# Логирование
LOG_LEVEL=INFO
LOG_FILE=app.log
FLASK_DEBUG=false
